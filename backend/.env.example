# Senate POS — Activation/MobilePoss backend environment.
# Copy to a secure location and provide these via your PHP host's
# environment (Apache SetEnv / php-fpm env / .htaccess / panel).
# NEVER commit real values.

# --- MySQL ---
DB_HOST=localhost
DB_NAME=posssistemadmin
DB_USER=
DB_PASS=

# --- API bearer tokens (comma-separated) ---
# Generate fresh random tokens — the old ones were leaked publicly.
API_TOKENS=token_one,token_two

# --- CORS allowed origins (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Telegram OTP (send_otp_telegram.php) ---
# Revoke the old bot via @BotFather and create a new token.
TG_BOT_TOKEN=
TG_CHAT_ID=
